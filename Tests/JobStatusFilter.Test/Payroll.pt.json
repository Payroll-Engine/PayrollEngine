            },
            {
              "wageTypeNumber": 205,
              "name": "ConsolidatedForecast",
              "description": "GetConsolidatedWageTypeResults with job status Forecast and forecast name",
              "valueExpression": "GetConsolidatedWageTypeResults(new(101, CycleStart, PayrunJobStatus.Forecast) { Forecast = \"StatusCheck\" }).Sum(x => x.Value)"
            },
            {
              "wageTypeNumber": 206,
              "name": "ConsolidatedAnyStatus",
              "description": "GetConsolidatedWageTypeResults without job status filter",
              "valueExpression": "GetConsolidatedWageTypeResults(new(101, CycleStart)).Sum(x => x.Value)"
            },
            {
              "wageTypeNumber": 211,
              "name": "PeriodComplete",
              "description": "GetWageTypeResults (previous period) with job status Complete",
              "valueExpression": "GetPeriodWageTypeResults(new(101, 1, PayrunJobStatus.Complete)).Sum(x => x.Value)"
            },
            {
              "wageTypeNumber": 212,
              "name": "PeriodForecast",
