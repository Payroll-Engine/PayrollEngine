      "regulations": [
        {
          "name": "JobStatusFilter.Test",
          "description": "Result queries with a job status filter must match the exact job status, not a bitwise subset",
          "cases": [
            {
              "name": "Salary",
              "caseType": "Employee",
              "defaultReason": "Change salary",
              "fields": [
                {
                  "name": "Salary",
                  "valueType": "Money",
                  "timeType": "CalendarPeriod"
                }
              ]
            }
          ],
          "collectors": [
            {
              "name": "Gross",
              "description": "Collects the salary and stores it as collector custom result",
              "applyExpression": "AddCustomResult(\"Salary\", WageTypeValue); return WageTypeValue;"
            }
          ],
          "wageTypes": [
            {
              "wageTypeNumber": 101,
              "name": "Salary",
              "description": "Salary, also stored as wage type custom result",
              "valueExpression": "var salary = (decimal)CaseValue[\"Salary\"]; AddCustomResult(\"Salary\", salary); return salary;",
              "collectors": [ "Gross" ]
            },
            {
              "wageTypeNumber": 201,
              "name": "ConsolidatedComplete",
              "description": "GetConsolidatedWageTypeResults with job status Complete",
              "valueExpression": "GetConsolidatedWageTypeResults(new(101, CycleStart, PayrunJobStatus.Complete)).Sum(x => x.Value)"
            },
            {
              "wageTypeNumber": 202,
              "name": "ConsolidatedRelease",
              "description": "GetConsolidatedWageTypeResults with job status Release",
              "valueExpression": "GetConsolidatedWageTypeResults(new(101, CycleStart, PayrunJobStatus.Release)).Sum(x => x.Value)"
            },
            {
              "wageTypeNumber": 203,
              "name": "ConsolidatedProcess",
