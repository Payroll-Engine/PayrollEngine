          "wageTypes": [
            {
              "wageTypeNumber": 100,
              "name": "PeriodStartDate",
              "description": "Period start as yyyymmdd",
              "valueExpression": "PeriodStart.Year * 10000 + PeriodStart.Month * 100 + PeriodStart.Day",
              "clusters": [
                "Legal",
                "Retro"
              ]
            },
            {
              "wageTypeNumber": 101,
              "name": "PeriodEndDate",
              "description": "Period end as yyyymmdd",
              "valueExpression": "PeriodEnd.Year * 10000 + PeriodEnd.Month * 100 + PeriodEnd.Day",
              "clusters": [
                "Legal",
                "Retro"
              ]
            },
            {
              "wageTypeNumber": 102,
              "name": "PayDate",
              "description": "Pay date as yyyymmdd",
              "valueExpression": "PayDate.Year * 10000 + PayDate.Month * 100 + PayDate.Day",
              "clusters": [
                "Legal",
                "Retro"
              ]
            },
            {
              "wageTypeNumber": 103,
              "name": "RegulationYear",
              "description": "Regulation year of the base regulation, overridden by the regulation valid from 2027",
              "valueExpression": "2026",
              "clusters": [
                "Legal",
                "Retro"
              ]
            },
            {
              "wageTypeNumber": 104,
              "name": "CycleYear",
              "description": "Year of the payrun cycle",
              "valueExpression": "CycleStart.Year",
              "clusters": [
                "Legal",
                "Retro"
              ]
            },
            {
              "wageTypeNumber": 105,
              "name": "CycleSalary",
              "description": "Consolidated salary of the previous cycle periods",
              "valueExpression": "GetConsolidatedWageTypeResults(new WageTypeConsolidatedResultQuery(110, CycleStart)).Sum(x => x.Value)",
              "clusters": [
                "Legal",
                "Retro"
              ]
            },
            {
              "wageTypeNumber": 106,
              "name": "FirstCyclePeriod",
              "description": "1 for the first period of the cycle, otherwise 0",
              "valueExpression": "FirstCyclePeriod ? 1 : 0",
              "clusters": [
                "Legal",
                "Retro"
              ]
            },
            {
              "wageTypeNumber": 107,
              "name": "PeriodsInCycle",
              "description": "Number of periods in the cycle",
              "valueExpression": "PeriodsInCycle",
              "clusters": [
                "Legal",
                "Retro"
              ]
            },
            {
              "wageTypeNumber": 110,
              "name": "Salary",
              "valueExpression": "CaseValue[\"Salary\"]",
              "clusters": [
                "Legal",
                "Retro"
              ]
            },
            {
              "wageTypeNumber": 111,
              "name": "SalaryRetroDiff",
              "valueExpression": "GetWageTypeRetroResultSum(110)",
              "clusters": [
                "Legal"
              ]
            },
            {
              "wageTypeNumber": 120,
              "name": "RetroPayDate",
              "description": "Pay date as yyyymmdd in retro runs only: retro jobs store changed results only",
              "valueExpression": "IsRetroPayrun ? PayDate.Year * 10000 + PayDate.Month * 100 + PayDate.Day : 0",
              "clusters": [
                "Legal",
                "Retro"
              ]
            },
            {
              "wageTypeNumber": 121,
              "name": "RetroRegulationYear",
              "description": "Regulation year in retro runs only, overridden by the regulation valid from 2027",
              "valueExpression": "IsRetroPayrun ? 2026 : 0",
              "clusters": [
                "Legal",
                "Retro"
              ]
